#!/usr/bin/env bash
set -Eeuo pipefail

COMMIT="e39890b86d2d1121aaadbdd1b2002707626c38d3"
WORK="$(mktemp -d /tmp/sg-panel-cap5-full-clean.XXXXXX)"
INSTALLER="$WORK/install.sh"
SOURCE_ZIP="$WORK/sg-panel-source.zip"

cleanup() {
  rm -rf "$WORK"
}
trap cleanup EXIT

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo "[SG-Panel] Запустите установщик через sudo/root." >&2
  exit 1
fi

echo "[SG-Panel] Source commit: $COMMIT"
echo "[SG-Panel] Загрузка точной версии SG-Panel..."

curl -fL --retry 3 --connect-timeout 15 \
  "https://raw.githubusercontent.com/s-gor/sg-panel/$COMMIT/install.sh" \
  -o "$INSTALLER"

curl -fL --retry 3 --connect-timeout 15 \
  "https://codeload.github.com/s-gor/sg-panel/zip/$COMMIT" \
  -o "$SOURCE_ZIP"

chmod 0755 "$INSTALLER"

echo "[SG-Panel] Запуск чистой установки..."
exec bash "$INSTALLER" --source-zip "$SOURCE_ZIP"
