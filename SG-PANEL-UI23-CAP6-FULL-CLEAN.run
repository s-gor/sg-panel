#!/usr/bin/env bash
set -Eeuo pipefail

COMMIT="352b53059bfdb0da8e9fbb0aa2600b8b7f1f3a49"
WORK="$(mktemp -d /tmp/sg-panel-cap6-full-clean.XXXXXX)"
CORE_INSTALLER="$WORK/install.sh"
SOURCE_ZIP="$WORK/sg-panel-source.zip"

PERM_HELPER="/usr/local/libexec/sg-panel-fix-geofiles-permissions"
DROPIN_DIR="/etc/systemd/system/xray.service.d"
DROPIN="$DROPIN_DIR/20-sg-panel-geofiles-permissions.conf"

cleanup() {
  rm -rf "$WORK"
}
trap cleanup EXIT

log() {
  printf '[SG-Panel] %s\n' "$*"
}

die() {
  printf '[SG-Panel] [ERROR] %s\n' "$*" >&2
  exit 1
}

wait_notice() {
  log "$*"
}

package_manager_busy_details() {
  local locks=(
    /var/lib/dpkg/lock-frontend
    /var/lib/dpkg/lock
    /var/lib/apt/lists/lock
    /var/cache/apt/archives/lock
  )
  local lock pids pid command_line output found=0

  if command -v fuser >/dev/null 2>&1; then
    for lock in "${locks[@]}"; do
      pids="$(fuser "$lock" 2>/dev/null || true)"
      [[ -n "$pids" ]] || continue
      found=1
      for pid in $pids; do
        command_line="$(ps -p "$pid" -o args= 2>/dev/null || true)"
        printf '%s: PID %s%s\n' \
          "$lock" "$pid" "${command_line:+ · $command_line}"
      done
    done
    (( found == 1 )) && return 0
  fi

  output="$({
    pgrep -a -x apt 2>/dev/null || true
    pgrep -a -x apt-get 2>/dev/null || true
    pgrep -a -x dpkg 2>/dev/null || true
    pgrep -a -f '(^|[[:space:]/])[u]nattended-upgrade([[:space:]]|$)' 2>/dev/null || true
  } | awk 'NF && !seen[$0]++')"
  [[ -n "$output" ]] || return 1
  printf '%s\n' "$output"
}

package_manager_busy() {
  package_manager_busy_details >/dev/null 2>&1
}

wait_for_apt() {
  local waited=0 timeout=300 detail=""
  while package_manager_busy; do
    if (( waited % 15 == 0 )); then
      detail="$(package_manager_busy_details 2>/dev/null | tr '\n' ';' | sed 's/;*$//' || true)"
      [[ -n "$detail" ]] || detail="активна блокировка APT/DPKG"
      wait_notice "APT/DPKG занят: $detail · ожидание ${waited}/${timeout} сек."
    fi
    if (( waited >= timeout )); then
      detail="$(package_manager_busy_details 2>/dev/null | tr '\n' ';' | sed 's/;*$//' || true)"
      die "APT/DPKG не освободил блокировку за ${timeout} секунд: ${detail:-владелец не определён}."
    fi
    sleep 5
    waited=$((waited + 5))
  done
  if (( waited > 0 )); then
    wait_notice "APT/DPKG блокировка снята; установка продолжается."
  fi
}

download_file() {
  local target="$1"
  shift
  local url part="${target}.part"
  rm -f "$target" "$part"
  for url in "$@"; do
    log "Загрузка: $url"
    rm -f "$part"
    if curl -fL \
      --retry 5 --retry-all-errors --retry-delay 3 \
      --connect-timeout 15 --max-time 300 \
      -H 'Cache-Control: no-cache' \
      -o "$part" "$url"; then
      if [[ -s "$part" ]]; then
        mv -f "$part" "$target"
        return 0
      fi
    fi
  done
  rm -f "$part"
  return 1
}

wait_for_service_active() {
  local unit="$1" label="$2"
  local attempt state=""
  for ((attempt=1; attempt<=20; attempt++)); do
    state="$(systemctl is-active "$unit" 2>/dev/null || true)"
    [[ "$state" == "active" ]] && return 0
    sleep 3
  done
  systemctl --no-pager --full status "$unit" >&2 2>/dev/null || true
  journalctl -u "$unit" -n 60 --no-pager >&2 2>/dev/null || true
  die "$label не находится в active после 60 секунд."
}

verify_panel_endpoint() {
  local marker="/etc/xpanel-mvp/install-complete.env"
  local mode host port attempt
  [[ -s "$marker" ]] || die "Не найден итоговый install-complete.env."
  mode="$(grep -E '^PANEL_ACCESS_MODE=' "$marker" | tail -1 | cut -d= -f2-)"
  host="$(grep -E '^PANEL_PUBLIC_HOST=' "$marker" | tail -1 | cut -d= -f2-)"
  port="$(grep -E '^PANEL_PUBLIC_PORT=' "$marker" | tail -1 | cut -d= -f2-)"
  [[ -n "$mode" && -n "$host" && "$port" =~ ^[0-9]+$ ]] ||
    die "Некорректное итоговое состояние доступа к панели."

  for ((attempt=1; attempt<=20; attempt++)); do
    if [[ "$mode" == "https" ]]; then
      if curl -kfsS --max-time 5 --resolve "$host:$port:127.0.0.1" \
        "https://$host:$port/login" | grep -Fq FIX40; then
        return 0
      fi
    else
      if curl -fsS --max-time 5 -H "Host: $host" \
        "http://127.0.0.1:$port/login" | grep -Fq FIX40; then
        return 0
      fi
    fi
    sleep 3
  done
  die "Панель не отдала страницу входа FIX40 после 60 секунд."
}

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  die "Запустите установщик через sudo/root."
fi

if ! command -v curl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
  log "Установка bootstrap-компонентов curl, сертификатов и Python..."
  wait_for_apt
  export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
  dpkg --configure -a
  apt-get -o DPkg::Lock::Timeout=30 -o Dpkg::Use-Pty=0 update -qq
  apt-get -o DPkg::Lock::Timeout=30 -o Dpkg::Use-Pty=0 install -y -qq \
    --no-install-recommends curl ca-certificates python3
fi

log "Source commit: $COMMIT"
log "Загрузка и проверка точной версии SG-Panel..."

download_file "$CORE_INSTALLER" \
  "https://raw.githubusercontent.com/s-gor/sg-panel/$COMMIT/install.sh" \
  "https://github.com/s-gor/sg-panel/raw/$COMMIT/install.sh" ||
  die "Не удалось скачать install.sh."

download_file "$SOURCE_ZIP" \
  "https://codeload.github.com/s-gor/sg-panel/zip/$COMMIT" \
  "https://github.com/s-gor/sg-panel/archive/$COMMIT.zip" ||
  die "Не удалось скачать архив исходников."

bash -n "$CORE_INSTALLER" || die "Скачанный install.sh повреждён."
python3 -m zipfile -t "$SOURCE_ZIP" >/dev/null ||
  die "Скачанный архив исходников повреждён."
chmod 0755 "$CORE_INSTALLER"

log "Подготовка постоянной защиты прав GeoFiles..."
install -d -m 0755 "$(dirname "$PERM_HELPER")"
cat > "$PERM_HELPER" <<'PERMISSION_HELPER_EOF'
#!/bin/sh
set -eu

install -d -o root -g root -m 0755 /usr/local/share/xray

for file in \
  /usr/local/share/xray/geoip.dat \
  /usr/local/share/xray/geosite.dat
do
  if [ -e "$file" ]; then
    chown root:root "$file"
    chmod 0644 "$file"
  fi
done
PERMISSION_HELPER_EOF
chown root:root "$PERM_HELPER"
chmod 0755 "$PERM_HELPER"

install -d -m 0755 "$DROPIN_DIR"
cat > "$DROPIN" <<DROPIN_EOF
[Service]
ExecStartPre=+$PERM_HELPER
DROPIN_EOF
chown root:root "$DROPIN"
chmod 0644 "$DROPIN"
systemctl daemon-reload

log "Запуск чистой или безопасно возобновляемой установки..."
bash "$CORE_INSTALLER" --source-zip "$SOURCE_ZIP"

"$PERM_HELPER"
systemctl daemon-reload

wait_for_service_active xray "Xray"
wait_for_service_active xpanel-web "SG-Panel"
wait_for_service_active nginx "Nginx"
verify_panel_endpoint

log "[OK] Чистая установка UI23 CAP6 завершена."
log "[OK] Xray: active"
log "[OK] SG-Panel: active"
log "[OK] Nginx: active"
